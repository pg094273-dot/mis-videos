{
  "name": "Mis Videos · Biblioteca personal de YouTube",
  "short_name": "Mis Videos",
  "description": "Biblioteca personal de vídeos de YouTube: añade enlaces, organízalos en listas y escúchalos con el móvil bloqueado.",
  "start_url": "./index.html",
  "scope": "./",
  "id": "mis-videos-iphone",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#080b16",
  "theme_color": "#080b16",
  "lang": "es",
  "dir": "ltr",
  "categories": ["entertainment", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Añadir vídeos", "short_name": "Añadir", "url": "./index.html#/", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Favoritos", "short_name": "Favoritos", "url": "./index.html#/favoritos" },
    { "name": "Pendientes", "short_name": "Pendientes", "url": "./index.html#/pendientes" }
  ]
}